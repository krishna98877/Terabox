# Temp Mail API Key — obtain from https://temp-mail.io/profile?section=api
TEMP_MAIL_API_KEY=your_api_key_here

# Optional: Default polling interval in milliseconds (default: 3000)
TEMP_MAIL_POLL_INTERVAL=3000

# Optional: Maximum polling attempts before giving up (default: 60)
TEMP_MAIL_MAX_POLL_ATTEMPTS=60

# Optional: Request timeout in milliseconds (default: 10000)
TEMP_MAIL_REQUEST_TIMEOUT=10000

# Optional: Maximum retry attempts (default: 3)
TEMP_MAIL_MAX_RETRIES=3

# Optional: Base delay for exponential backoff in ms (default: 1000)
TEMP_MAIL_RETRY_BASE_DELAY=1000

# Optional: Session file path for tracking active inboxes (default: .temp-mail-session.json)
TEMP_MAIL_SESSION_FILE=.temp-mail-session.json
