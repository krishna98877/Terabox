# Database (SQLite)
DATABASE_URL="file:./db/production.db"

# Groq AI API Key (for smart email analysis, suggestions, error diagnosis)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=

# 2Captcha API Key (for solving reCAPTCHA, Turnstile, image CAPTCHAs)
# Get your key at: https://2captcha.com/ (paid service, ~$1-3/1000 solves)
# Required for API-based signup when TeraBox requires CAPTCHA verification
TWOCAPTCHA_API_KEY=

# CatchMail.io custom domain (optional)
# If you have a custom domain with MX pointing to smtp.catchmail.io
# CATCHMAIL_CUSTOM_DOMAIN=

# Node
NODE_ENV=production
