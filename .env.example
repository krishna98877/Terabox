# Database (SQLite)
DATABASE_URL="file:./db/production.db"

# Groq AI API Key (for smart email analysis, suggestions, error diagnosis)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=

# ═══════════════════════════════════════════════════════════════════════
# CaptchaSolv API Key (CAPTCHA solver — 100 FREE solves/day!)
# ═══════════════════════════════════════════════════════════════════════
#
# FREE: 100 solves/day
# - 2captcha-compatible API format
# - Sync endpoint: POST /solve (handles polling internally, up to 120s)
# - Async: POST /createTask → POST /getTaskResult
# - 10+ captcha types, average solve time < 15 seconds
# - reCAPTCHA v2 (7-40s), v3 (3-5s), Turnstile (4-7s), hCaptcha, GeeTest v4
# - waitForSlot: true to queue instead of failing when limit reached
#
# Get your API key: Join CaptchaSolv Discord → use /panel command
# Docs: https://docs.captchasolv.com/
# Base URL: https://v1.captchasolv.com
#
CAPTCHASOLV_API_KEY=

# CatchMail.io custom domain (optional)
# If you have a custom domain with MX pointing to smtp.catchmail.io
# CATCHMAIL_CUSTOM_DOMAIN=

# Node
NODE_ENV=production
