# Database (SQLite)
DATABASE_URL="file:./db/production.db"

# Groq AI API Key (for smart email analysis, suggestions, error diagnosis)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=

# NoCaptchaAI API Key (PRIMARY captcha solver — 6,000 FREE solves/month!)
# Get your key at: https://nocaptchaai.com/ (sign up → dashboard)
# Supports: reCAPTCHA v2/v3, Turnstile, GeeTest, ImageToText
# Pricing: Free 6k/mo, then $0.14-0.50/1000
NOCAPTCHA_API_KEY=

# 2Captcha API Key (FALLBACK captcha solver — paid only)
# Get your key at: https://2captcha.com/
# Only used if NoCaptchaAI is not configured or fails
# Pricing: $1-3/1000 solves
TWOCAPTCHA_API_KEY=

# CatchMail.io custom domain (optional)
# If you have a custom domain with MX pointing to smtp.catchmail.io
# CATCHMAIL_CUSTOM_DOMAIN=

# Node
NODE_ENV=production
