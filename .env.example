# Database (SQLite)
DATABASE_URL="file:./db/production.db"

# Groq AI API Key (for smart email analysis, suggestions, error diagnosis)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=

# ═══════════════════════════════════════════════════════════════════════
# NopeCHA API Key (★ PRIMARY captcha solver — FREE!)
# ═══════════════════════════════════════════════════════════════════════
#
# FREE TIER: 100 credits/day (daily reset — NEVER runs out!)
#
# Token API (for headless automation):
#   - POST /v1/token/recaptcha_v2 → get valid CAPTCHA token
#   - Cost: 20 credits/solve = 5 reCAPTCHA solves/day on free tier
#   - No browser needed! Perfect for headless Puppeteer on Render
#
# Recognition API (for image-based solving):
#   - POST /v1/recognition/recaptcha → get click coordinates
#   - Cost: 1 credit/solve = 100 solves/day on free tier
#
# Turnstile API:
#   - Cost: 1 credit/solve = 100 solves/day on free tier
#
# AUTHENTICATION:
#   - Residential IP: NO API key needed! Your IP IS your key.
#   - Server/datacenter IP: Set NOPECHA_API_KEY (get from https://nopecha.com/manage)
#   - If server IP blocked, request whitelist on NopeCHA Discord
#
# Get your key at: https://nopecha.com/manage (sign in with Google/Discord)
# Status check: https://api.nopecha.com/v1/status
#
NOPECHA_API_KEY=

# NoCaptchaAI API Key (BACKUP captcha solver — 6,000 FREE solves one-time)
# Get your key at: https://nocaptchaai.com/ (sign up → dashboard)
# Supports: reCAPTCHA v2/v3, Turnstile, GeeTest, ImageToText
# Pricing: Free 6k total (no reset), then $0.14-0.50/1000
NOCAPTCHA_API_KEY=

# 2Captcha API Key (LAST RESORT captcha solver — paid only)
# Get your key at: https://2captcha.com/
# Pricing: $1-3/1000 solves
TWOCAPTCHA_API_KEY=

# CatchMail.io custom domain (optional)
# If you have a custom domain with MX pointing to smtp.catchmail.io
# CATCHMAIL_CUSTOM_DOMAIN=

# Node
NODE_ENV=production
