# Database (SQLite)
DATABASE_URL="file:./db/production.db"

# Groq AI API Key (for smart email analysis, suggestions, error diagnosis)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=

# ═══════════════════════════════════════════════════════════════════════
# CaptchaSolv API Key (CAPTCHA solver — 100 FREE solves/day!)
# ═══════════════════════════════════════════════════════════════════════
#
# FREE: 100 solves/day (claim daily via Discord /claim)
# - 2captcha-compatible API format per https://docs.captchasolv.com/
# - Sync endpoint: POST /solve (recommended, handles polling internally, up to 120s)
# - Async: POST /createTask → POST /getTaskResult (3-5s poll interval)
# - 10+ captcha types, average solve time < 15 seconds
# - reCAPTCHA v2 (7-40s), v2 Enterprise (7-40s), v3 (3-5s), v3 Enterprise (3-5s)
# - Turnstile (4-7s), hCaptcha, GeeTest v4
# - waitForSlot: true queues instead of failing on ERROR_LIMIT_EXCEEDED (waits up to 300s)
# - Token expiry: ~2 min for reCAPTCHA, ~5 min for Turnstile — use immediately!
#
# Get your API key: Discord /panel command or Telegram bot
# Docs: https://docs.captchasolv.com/getting-started/
# Base URL: https://v1.captchasolv.com
#
CAPTCHASOLV_API_KEY=

# TeraBox reCAPTCHA site key (optional override)
# If TeraBox rotates their site key, set it here to override the default.
# Default: 6LceASUfAAAAAHBcvTdvuPVie_9yzavGubPLOGTH
# RECAPTCHA_SITE_KEY=

# CatchMail.io custom domain (optional)
# If you have a custom domain with MX pointing to smtp.catchmail.io
# CATCHMAIL_CUSTOM_DOMAIN=

# Node
NODE_ENV=production
